# Environment Configuration Template for ProfitGuard

# Application Port
PORT=3000
VITE_API_URL=http://localhost:3000/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profitguard?schema=public

# Session Secret (Min 32 characters)
SESSION_SECRET=profitguard_super_secret_session_key_32_chars_minimum

# Shopify App Integration
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_metafields
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/integrations/shopify/callback

# AI Analyst Service (Optional / Milestone 6)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash
